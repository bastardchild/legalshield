# Test-environment settings for LegalShield Agent.
#
# Committed template — unlike `.env` (git-ignored, may hold secrets) this file is safe
# to version. The docker-compose `test` service sets the same values inline; keep them in
# sync when the test configuration changes.
#
# DOCS_ENABLED=false exercises the docs-disabled code path: /docs, /redoc and
# /openapi.json are not registered at all, so they answer 404.

DATABASE_URL=postgresql+asyncpg://legalshield:legalshield@postgres:5432/legalshield
REDIS_URL=redis://redis:6379/0
HERMES_BASE_URL=http://llm.invalid
HERMES_API_KEY=test-key
LLM_MODEL=test-model
FONNTE_TOKEN=test-token
FONNTE_BASE_URL=http://fonnte.invalid
APP_BASE_URL=http://localhost:8000

DOCS_ENABLED=false
